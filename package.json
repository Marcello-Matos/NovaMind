{
  "name": "novamind",
  "version": "0.1.0",
  "private": true,
  "description": "NovaMind — plataforma de assistentes inteligentes pessoais e empresariais",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @novamind/api",
    "dev:app": "cd apps/app && flutter run -d web-server --web-port=3000",
    "build": "npm run build --workspace @novamind/api && cd apps/app && flutter build web",
    "typecheck": "npm run typecheck --workspace @novamind/api && cd apps/app && flutter analyze",
    "lint": "npm run lint --workspaces --if-present",
    "test": "cd apps/app && flutter test",
    "db:generate": "npm run db:generate --workspace @novamind/api",
    "db:migrate": "npm run db:migrate --workspace @novamind/api",
    "db:push": "npm run db:push --workspace @novamind/api",
    "db:studio": "npm run db:studio --workspace @novamind/api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  }
}
