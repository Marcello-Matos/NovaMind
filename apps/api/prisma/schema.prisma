generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============ ENUMS ============

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum PlanTier {
  FREE
  PERSONAL_PRO
  BUSINESS
  BUSINESS_PRO
}

enum AgentType {
  PERSONAL
  BUSINESS_FAQ
  BUSINESS_SALES
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

enum UsageEventType {
  CHAT_COMPLETION
  EMBEDDING
  TOOL_EXECUTION
  DOCUMENT_PROCESSING
}

// ============ NÚCLEO ============

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String?  @map("password_hash") // null em contas criadas via OAuth
  avatarUrl    String?  @map("avatar_url")    // foto do provedor social (Google)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  members        Member[]
  conversations  Conversation[]
  tasks          Task[]             @relation("TaskOwner")
  memories       MemoryEntry[]
  usageEvents    UsageEvent[]
  auditEvents    AuditEvent[]       @relation("AuditActor")
  documents      KnowledgeDocument[] @relation("DocumentUploader")
  oauthAccounts  OauthAccount[]
  calendarEvents CalendarEvent[]
  habits         Habit[]
  notes          Note[]
  reminders      Reminder[]
  googleCalendar GoogleCalendarAccount?

  @@map("users")
}

model OauthAccount {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  provider       String   // google | apple
  providerUserId String   @map("provider_user_id") // "sub" do identity token
  email          String?
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      PlanTier @default(FREE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members       Member[]
  conversations Conversation[]
  tasks         Task[]
  documents     KnowledgeDocument[]
  leads         Lead[]
  subscriptions Subscription[]
  usageEvents   UsageEvent[]
  calendarEvents CalendarEvent[]
  notes          Note[]
  integrations  Integration[]
  auditEvents   AuditEvent[]

  @@map("organizations")
}

model Member {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           MemberRole   @default(MEMBER)
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("members")
}

// ============ CONVERSAS ============

model Conversation {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  organizationId String?   @map("organization_id")
  agent          AgentType @default(PERSONAL)
  title          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([userId, organizationId])
  @@map("conversations")
}

model Message {
  id                  String      @id @default(uuid())
  conversationId      String      @map("conversation_id")
  role                MessageRole
  content             String
  toolName            String?     @map("tool_name")
  toolCalls           Json?       @map("tool_calls")
  promptTokens        Int?        @map("prompt_tokens")
  completionTokens    Int?        @map("completion_tokens")
  estimatedCostUsd    Float?      @map("estimated_cost_usd")
  createdAt           DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ============ MEMÓRIA CONTROLÁVEL ============

model MemoryEntry {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  key       String
  value     String
  enabled   Boolean  @default(true)
  source    String?  // "user" | "assistant"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
  @@map("memory_entries")
}

// ============ BASE DE CONHECIMENTO ============

model KnowledgeDocument {
  id             String         @id @default(uuid())
  userId         String?        @map("user_id")
  organizationId String?        @map("organization_id")
  fileKey        String         @map("file_key")
  fileName       String         @map("file_name")
  mimeType       String         @map("mime_type")
  sizeBytes      Int            @map("size_bytes")
  status         DocumentStatus @default(PENDING)
  error          String?
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  uploader     User?           @relation("DocumentUploader", fields: [userId], references: [id], onDelete: SetNull)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks       DocumentChunk[]

  @@index([organizationId, status])
  @@index([userId, status])
  @@map("knowledge_documents")
}

model DocumentChunk {
  id         String                    @id @default(uuid())
  documentId String                    @map("document_id")
  chunkIndex Int                       @map("chunk_index")
  content    String
  embedding  Unsupported("vector(1536)")?
  source     Json?
  createdAt  DateTime                  @default(now()) @map("created_at")

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_chunks")
}

// ============ TAREFAS ============

model Task {
  id             String       @id @default(uuid())
  ownerId        String       @map("owner_id")
  organizationId String?      @map("organization_id")
  title          String
  description    String?
  status         TaskStatus   @default(OPEN)
  priority       TaskPriority @default(MEDIUM)
  dueAt          DateTime?    @map("due_at")
  remindAt       DateTime?    @map("remind_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  owner        User          @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([organizationId, status])
  @@map("tasks")
}

// ============ CRM SIMPLES ============

model Lead {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  email          String?
  phone          String?
  source         String?
  notes          String?
  qualified      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("leads")
}

// ============ MONETIZAÇÃO / USO ============

model Subscription {
  id                   String             @id @default(uuid())
  organizationId       String?            @map("organization_id")
  plan                 PlanTier           @default(FREE)
  provider             String?            // stripe | manual | ...
  providerCustomerId   String?            @map("provider_customer_id")
  providerSubscriptionId String?          @map("provider_subscription_id")
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("subscriptions")
}

model UsageEvent {
  id               String         @id @default(uuid())
  userId           String         @map("user_id")
  organizationId   String?        @map("organization_id")
  eventType        UsageEventType @map("event_type")
  model            String?
  promptTokens     Int            @default(0) @map("prompt_tokens")
  completionTokens Int            @default(0) @map("completion_tokens")
  estimatedCostUsd Float          @default(0) @map("estimated_cost_usd")
  metadata         Json?
  createdAt        DateTime       @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@map("usage_events")
}

// ============ INTEGRAÇÕES E AUDITORIA ============

model Integration {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  provider       String   // whatsapp | google_calendar | stripe | ...
  scope          String?
  credentialRef  String   @map("credential_ref") // referência no secret manager — nunca o segredo em si
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider])
  @@map("integrations")
}

// ============ AGENDA, HÁBITOS, NOTAS E LEMBRETES ============

enum CalendarEventSource {
  APP
  AGENT
  GOOGLE
}

model CalendarEvent {
  id             String              @id @default(uuid())
  ownerId        String              @map("owner_id")
  organizationId String?             @map("organization_id")
  title          String
  description    String?
  location       String?
  startsAt       DateTime            @map("starts_at")
  endsAt         DateTime?           @map("ends_at")
  allDay         Boolean             @default(false) @map("all_day")
  source         CalendarEventSource @default(APP)
  googleEventId  String?             @map("google_event_id")
  googleSyncedAt DateTime?           @map("google_synced_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([ownerId, googleEventId])
  @@index([ownerId, startsAt])
  @@index([organizationId, startsAt])
  @@map("calendar_events")
}

model Habit {
  id         String   @id @default(uuid())
  ownerId    String   @map("owner_id")
  name       String
  icon       String?
  color      String?
  daysOfWeek String   @default("0,1,2,3,4,5,6") @map("days_of_week") // dias em que vale, 0=dom
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  owner User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  logs  HabitLog[]

  @@index([ownerId, active])
  @@map("habits")
}

model HabitLog {
  id      String   @id @default(uuid())
  habitId String   @map("habit_id")
  date    DateTime @db.Date // dia (00:00 UTC representativo do dia local)
  done    Boolean  @default(true)
  note    String?
  createdAt DateTime @default(now()) @map("created_at")

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@map("habit_logs")
}

model Note {
  id             String   @id @default(uuid())
  ownerId        String   @map("owner_id")
  organizationId String?  @map("organization_id") // null = nota pessoal
  title          String
  content        String   @db.Text
  pinned         Boolean  @default(false)
  tags           String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt])
  @@index([organizationId, updatedAt])
  @@map("notes")
}

enum ReminderRepeat {
  NONE
  DAILY
  WEEKLY
}

model Reminder {
  id             String         @id @default(uuid())
  ownerId        String         @map("owner_id")
  title          String
  remindAt       DateTime       @map("remind_at")
  repeatRule     ReminderRepeat @default(NONE) @map("repeat_rule")
  source         String         @default("manual") // manual | agent | task | event
  taskId         String?        @map("task_id")
  eventId        String?        @map("event_id")
  localNotified  Boolean        @default(false) @map("local_notified") // app já agendou a notificação local
  firedAt        DateTime?      @map("fired_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, remindAt])
  @@map("reminders")
}

// Conta Google Calendar do usuário (integração pessoal, não da organização)
model GoogleCalendarAccount {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  googleEmail       String    @map("google_email")
  refreshToken      String    @map("refresh_token") // cifrado (AES-256-GCM, chave em GOOGLE_TOKEN_SECRET)
  scope             String
  syncToken         String?   @map("sync_token") // sync incremental do Google
  connectedAt       DateTime  @default(now()) @map("connected_at")
  lastSyncAt        DateTime? @map("last_sync_at")
  lastSyncDirection String?   @map("last_sync_direction")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_calendar_accounts")
}

model AuditEvent {
  id             String   @id @default(uuid())
  actorId        String?  @map("actor_id")
  organizationId String?  @map("organization_id")
  action         String
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_events")
}
