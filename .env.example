# ===== API =====
NODE_ENV=development
API_PORT=3001

# PostgreSQL (docker-compose)
DATABASE_URL=postgresql://novamind:novamind@localhost:5432/novamind

# Redis / BullMQ (docker-compose)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Login social (verificação de tokens no backend)
# Client IDs separados por vírgula — um por plataforma (web, iOS, Android)
GOOGLE_CLIENT_IDS=
# Bundle ID do app iOS + Service ID da web, separados por vírgula
APPLE_CLIENT_IDS=

# Storage S3-compatível (MinIO via docker-compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=novamind
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ===== App (Flutter) =====
# A URL da API é passada via --dart-define=API_URL (default http://localhost:3001).
# WEB_ORIGIN restringe CORS em produção; em dev, qualquer porta localhost é aceita.
# WEB_ORIGIN=https://app.novamind.example
